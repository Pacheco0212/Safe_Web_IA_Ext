{
    "name": "SafeWeb IA Extension",
    "description": "An extension to enhance web safety using AI.",
    "version": "1.0",
    "manifest_version": 3,
    "options_page": "ui/options/options.html",

    "background": {
    "service_worker": "core/service_worker.js",
    "type": "module"
     },

    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["ui/bubble/bubble_injector.js"],
        "css": ["ui/bubble/bubble.css"],
        "run_at": "document_idle"
    }
    ],

    "action": {
        "default_title": "SafeWeb IA",
        "default_popup": "ui/popup/popup.html",
        "default_icon": "ui/icons/safe.png"
    },

    "icons": {
    "16": "ui/icons/safe.png",
    "48": "ui/icons/safe.png",
    "128": "ui/icons/safe.png"
    },

    "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "offscreen"
    ],

    "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://www.virustotal.com/*",
    "https://www.urlscan.io/*",
    "https://api.ssllabs.com/*",
    "https://safebrowsing.googleapis.com/*",
    "https://www.whoisxmlapi.com/*",
    "https://api.whoisfreaks.com/*"
    ],

    "web_accessible_resources": [
    {
        "resources": [
        "ai/Modelo_JS_v13/model.json",
        "ai/Modelo_JS_v13/group1-shard1of1.bin",
        "ai/Modelo_JS_v13/normalization.json",
        
        "ai/tf-core.min.js",
        "ai/tf-layers.min.js",
        "ai/tf-backend-wasm.min.js",
        "ai/tf-backend-wasm.wasm",

        "ai/offscreen.html",
        "ai/offscreen.js"
        ],
        "matches": ["<all_urls>"]
    }
    ],

    "content_security_policy": {
    "extension_pages": 
        "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
    
}