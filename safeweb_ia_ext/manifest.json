{
    "name": "SafeWeb IA Extension",
    "description": "An extension to enhance web safety using AI.",
    "version": "1.0",
    "manifest_version": 3,
    "options_page": "ui/options/options.html",

    "background": {
    "service_worker": "core/service_worker.js",
    "type": "module"
     },

    "action": {
        "default_title": "SafeWeb IA",
        "default_popup": "ui/popup/popup.html",
        "default_icon": "ui/icons/shield-png.png"
    },

    "icons": {
    "16": "ui/icons/shield-png.png",
    "48": "ui/icons/shield-png.png",
    "128": "ui/icons/shield-png.png"
    },

    "permissions": [
    "tabs",
    "webNavigation",
    "storage"
    ],

    "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://www.virustotal.com/*",
    "https://www.urlscan.io/*",
    "https://api.ssllabs.com/*",
    "https://safebrowsing.googleapis.com/*"
    ]
    
}